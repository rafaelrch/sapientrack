
# PostgreSQL
# Usados pelo container do Postgres para criar o usuário e o banco na primeira subida.
POSTGRES_USER=usuario_do_banco
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=nome_do_banco

# API
# Conexão da API com o banco: usuário, senha e banco têm que ser os mesmos de cima.
# Host localhost porque a API roda fora do Docker, no Windows.
# Quando a API rodar dentro do docker-compose, troque localhost pelo nome do serviço do banco.
DATABASE_URL=postgresql://usuario_do_banco:troque_esta_senha@localhost:5432/nome_do_banco